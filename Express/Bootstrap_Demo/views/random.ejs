<!-- これで別のファイルに定義された内容を読み込むことができる partialsは任意の名前でOK
  -とするとhtmlがエスケープされないのでテンプレートとして読み込むことができる
  エスケープされる場合(%の場合)はhtmlを文字列に含めた場合にそのhtmlがそのままページに出力される
  -->
<%- include('partials/head') %>

   <%- include('partials/navbar') %>
    <!--
    テンプレートの中でロジックを直接書くことも出来るが、あまりきれいではないので
    テンプレートではデータを貰うだけにしてロジックは記載するのが理想
    <h1>ランダムな値:<%= Math.floor(Math.random() * 10) + 1 %></h1>
    -->
    <!-- これで呼び出し元で設定されたnumの値を受け取る-->
    <h1>ランダムな値:<%= num %></h1>

    <!-- javascriptを書きたいけど表示はさせたくない場合は <% %> にする。 -->
    <h1>ランダムな値:<%= num %></h1>
    <% if (num % 2 === 0) { %>
        <h2>偶数やで</h2>
    <% } else { %>
        <h2>奇数でっせ</h2>
    <% } %>
    <!-- 三項演算子の場合は式の結果をHTMLに埋め込みたいので<%= %>にする必要がある -->
    <h3><%= num % 2 === 0 ? '偶数' : '奇数' %></h3>
<%- include('partials/footer') %>
