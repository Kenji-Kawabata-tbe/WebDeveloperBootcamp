<!-- これで別のファイルに定義された内容を読み込むことができる partialsは任意の名前でOK
  -とするとhtmlがエスケープされないのでテンプレートとして読み込むことができる
  エスケープされる場合(%の場合)はhtmlを文字列に含めた場合にそのhtmlがそのままページに出力される
  -->
<%- include('partials/head') %>

    <%- include('partials/navbar') %>
    <h1>ネコたち</h1>
    <!-- こうすると配列catsの値がカンマ区切りで横並びでそれぞれ出力される
    <%= cats %>
    -->
    <!-- こうすると配列catsの値がそれぞれliで出力される -->
    <ul>
        <% for(let cat of cats) { %>
            <li><%= cat %></li>
        <% } %>
    </ul>
<%- include('partials/footer') %>
